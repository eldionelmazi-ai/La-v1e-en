<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>La Vie en – Speisekarte</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

<header class="hero">
    <div class="hero-overlay">
        <p class="eyebrow">CAFÉ • MÖDLING</p>

        <h1>La Vie en</h1>

        <p class="hero-text">
            Italienische Küche mit Liebe & Leidenschaft
        </p>

        <a href="#speisekarte" class="button">
            Speisekarte ansehen
        </a>
    </div>
</header>


<section class="intro">
    <h2>Willkommen bei La Vie en</h2>

    <p>
        Genießen Sie ausgewählte Spezialitäten, frische Zutaten
        und mediterrane Küche in stilvollem Ambiente.
    </p>
</section>


<section id="speisekarte" class="menu">

    <h2>Speisekarte</h2>

    <!-- FISCH -->

    <div class="category">
        <h3>Fisch</h3>

        <div class="menu-grid">

            <div class="dish">
                <img src="IMG_3705.jpeg" alt="Filets vom Emder Logger-Matjes">

                <div class="dish-content">
                    <h4>Filets vom Emder Logger-Matjes</h4>
                    <p>
                        mit Joghurtsauce, Zwiebel, Apfel und grünen Speckbohnen
                    </p>
                    <span>22,90 €</span>
                </div>
            </div>


            <div class="dish">
                <img src="IMG_3706.jpeg" alt="Gebratene Schollenfilets">

                <div class="dish-content">
                    <h4>Gebratene Schollenfilets</h4>
                    <p>
                        mit Nordseekrabben, Zitronen-Butter-Schaum,
                        Ratatouille und Kräutern
                    </p>
                    <span>25,90 €</span>
                </div>
            </div>


            <div class="dish">
                <img src="IMG_3708.jpeg" alt="Filet vom norwegischen Fjordlachs">

                <div class="dish-content">
                    <h4>Filet vom norwegischen Fjordlachs</h4>
                    <p>
                        kross auf der Haut gebraten mit Dill-Senfsoße,
                        Gemüse und Kartoffeln
                    </p>
                    <span>26,90 €</span>
                </div>
            }


            <div class="dish">
                <img src="IMG_3709.jpeg" alt="Variation von Nordseefischen">

                <div class="dish-content">
                    <h4>Variation von Nordseefischen</h4>
                    <p>
                        frische Kutterscholle und verschiedene
                        Filets mit saisonaler Beilage
                    </p>
                    <span>27,90 €</span>
                </div>
            </div>

        </div>
    </div>


    <!-- FLEISCH -->

    <div class="category">
        <h3>Fleisch</h3>

        <div class="menu-grid">

            <div class="dish">
                <img src="IMG_3710.jpeg" alt="Zarte Maishähnchenbrust">

                <div class="dish-content">
                    <h4>Zarte Maishähnchenbrust</h4>
                    <p>
                        mit Tomaten, Mozzarella und Basilikum gratiniert
                    </p>
                    <span>21,90 €</span>
                </div>
            </div>


            <div class="dish">
                <img src="IMG_3711.jpeg" alt="Wiener Kalbsschnitzel">

                <div class="dish-content">
                    <h4>Wiener Kalbsschnitzel</h4>
                    <p>
                        mit Panko-Panade und Kapern-Zitronen-Butter,
                        dazu Kartoffelsalat
                    </p>
                    <span>26,90 €</span>
                </div>
            </div>


            <div class="dish">
                <div class="dish-content no-image">
                    <h4>Trilogie vom Filet</h4>
                    <p>
                        Rinderfilet, Maishähnchenbrust und Schweinefilet
                        mit saisonaler Beilage
                    </p>
                    <span>27,90 €</span>
                </div>
            </div>


            <div class="dish">
                <div class="dish-content no-image">
                    <h4>Black Angus Rumpsteak</h4>
                    <p>
                        mit rauchiger Whiskey-Pfeffer-Soße,
                        knusprigen Kartoffeln und Gemüse
                    </p>
                    <span>29,90 €</span>
                </div>
            </div>

        </div>
    </div>


    <!-- VEGAN -->

    <div class="category">
        <h3>Vegan</h3>

        <div class="menu-grid">

            <div class="dish">
                <div class="dish-content no-image">
                    <h4>Süßkartoffel-Linsen-Curry</h4>
                    <p>
                        mit Kokosmilch, Koriander und Wildreis
                    </p>
                    <span>19,90 €</span>
                </div>
            </div>


            <div class="dish">
                <div class="dish-content no-image">
                    <h4>Tomaten-Ragout</h4>
                    <p>
                        mit schwarzen Oliven und gebratenen Artischocken
                    </p>
                    <span>19,90 €</span>
                </div>
            </div>

        </div>
    </div>


    <!-- FRÜHSTÜCK -->

    <div class="category">
        <h3>Frühstück & Specials</h3>

        <div class="menu-grid">

            <div class="dish featured">

                <img src="IMG_3706.jpeg" alt="Salmon Protein Toast">

                <div class="dish-content">

                    <h4>Salmon Protein Toast</h4>

                    <p>
                        Knuspriger Toast mit Avocado,
                        Rührei, frischem Salat,
                        Cherrytomaten und Räucherlachs
                    </p>

                    <span>16,90 €</span>

                </div>
            </div>


            <div class="dish featured">

                <img src="IMG_3708.jpeg" alt="Scrambled Egg Toast">

                <div class="dish-content">

                    <h4>Scrambled Egg Toast</h4>

                    <p>
                        Geröstetes Brot mit cremigem Rührei,
                        Avocado, Blattsalat, Cherrytomaten,
                        Parmesan und Balsamico
                    </p>

                    <span>13,90 €</span>

                </div>
            </div>

        </div>
    </div>


    <!-- DESSERT -->

    <div class="category">
        <h3>Dessert</h3>

        <div class="menu-grid">

            <div class="dish">

                <img src="IMG_3709.jpeg" alt="Mohn Cheesecake">

                <div class="dish-content">

                    <h4>Mohn Cheesecake</h4>

                    <p>
                        Cremiger Cheesecake mit Mohn
                        und fruchtigem Beeren-Topping
                    </p>

                    <span>7,90 €</span>

                </div>
            </div>

        </div>
    </div>


    <!-- GETRÄNKE -->

    <div class="category">
        <h3>Getränke</h3>

        <div class="menu-grid">

            <div class="dish">

                <img src="IMG_3711.jpeg" alt="Strawberry Lemon Refresher">

                <div class="dish-content">

                    <h4>Strawberry Lemon Refresher</h4>

                    <p>
                        Erfrischendes Getränk mit Erdbeere,
                        Zitrone, Limette und Eis
                    </p>

                    <span>6,90 €</span>

                </div>
            </div>

        </div>
    </div>

</section>


<section class="about">

    <h2>La Vie en</h2>

    <p>
        Frische Zutaten, kreative Küche und ein Ort,
        an dem man gerne länger bleibt.
    </p>

    <a href="#speisekarte" class="button">
        Zur Speisekarte
    </a>

</section>


<footer>

    <h3>La Vie en</h3>

    <p>Café • Mödling</p>

    <p>
        © 2026 La Vie en – Alle Rechte vorbehalten
    </p>

</footer>

